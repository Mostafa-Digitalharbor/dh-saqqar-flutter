<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31) backup / device-transfer rules. Paired with
  android:allowBackup="false": we exclude the app's entire data domain from
  BOTH cloud backup and device-to-device transfer so the encrypted
  credential/token store (and any cached state) can never leave the device
  through a restore/migration flow.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>
