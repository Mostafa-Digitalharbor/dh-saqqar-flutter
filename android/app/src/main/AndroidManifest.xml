<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Network access. INTERNET is what every Dio request to
         saqqaar.com needs; ACCESS_NETWORK_STATE is what the
         connectivity_plus plugin reads to drive the OfflineBanner.

         The debug + profile manifests each declare INTERNET on their
         own so `flutter run` (dev / hot-reload builds) works without
         touching this file. Release APKs ONLY merge from main, so
         leaving these out here is what produced "Couldn't reach the
         server" on every device the team installed the APK on while
         the dev build worked fine. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Biometric app lock (local_auth). USE_BIOMETRIC is the modern
         permission; the device-credential (PIN/pattern) fallback needs no
         extra permission. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>
    <!-- Push notifications (FCM). POST_NOTIFICATIONS is the runtime permission
         required from Android 13 (API 33); older versions grant it implicitly.
         The client requests it at runtime via FirebaseMessaging. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- Voice input via the composer mic button. The audio is handed
         to Android's on-device SpeechRecognizer (no audio bytes leave
         the phone). Declared as a runtime permission — the chat asks
         the user the first time they tap the mic; subsequent taps reuse
         the granted permission. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- Strip the broad photo/video permissions that the image_picker_android
         plugin injects for its gallery feature. This app never uses that path:
         "Photos" and "Files" both go through file_picker (the Android Photo
         Picker / SAF, which needs NO media permission), and image_picker is
         used ONLY for the camera. Declaring READ_MEDIA_IMAGES/VIDEO would trip
         Google Play's Photo & Video Permissions policy ("use the system photo
         picker instead") and force an unwinnable declaration. tools:node="remove"
         deletes them from the merged manifest so the shipped bundle requests
         neither. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" tools:node="remove"/>
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" tools:node="remove"/>
    <!-- READ_MEDIA_AUDIO rides in from the same plugin. The app never reads
         audio FILES — voice input is live mic capture (RECORD_AUDIO) handed
         straight to SpeechRecognizer, and no attachment path selects audio.
         Drop it too so the bundle carries no unused media permission. -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" tools:node="remove"/>
    <application
        android:label="Saqqar"
        android:name="${applicationName}"
        android:icon="@mipmap/launcher_icon"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config">
        <!-- allowBackup=false + dataExtractionRules: the app holds live Odoo
             credentials + bearer tokens (in EncryptedSharedPreferences).
             Even though the encryption key lives in the AndroidKeyStore and
             isn't backed up, we don't want the encrypted blobs (or any plain
             cached state) leaving the device via cloud auto-backup / adb
             backup / device-to-device transfer. networkSecurityConfig pins an
             explicit "no cleartext" posture (already the targetSdk default —
             this makes it independent of any future SDK downgrade). -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Legacy custom-scheme deep links (push notifications), see
                 lib/core/routing/deep_links.dart. Mirrors the CFBundleURLTypes
                 entry already declared in ios/Runner/Info.plist. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="saqqar"/>
            </intent-filter>
            <!-- Verified App Links (docs/SAQQAR_DEEP_LINKS_FLUTTER.md §2).
                 A tapped https://saqqaar.com/... link opens the app directly,
                 with no "open with" chooser, because android:autoVerify makes
                 Android fetch and check
                 https://saqqaar.com/.well-known/assetlinks.json against this
                 build's signing SHA-256 (published by the backend). If the app
                 isn't installed the link just opens in the browser.

                 The URI is received in Dart by the app_links plugin and routed
                 via DeepLinks (see lib/core/routing/deep_link_service.dart) —
                 NOT by the Flutter engine's built-in deep-linking, which is
                 turned off below so the two never double-handle a link. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <!-- Claim ONLY the paths the app actually has a screen for.
                     autoVerify still verifies the whole host against
                     assetlinks.json; these <data> entries just scope WHICH
                     paths open the app. Everything not listed (/privacy,
                     /terms, /auth/*, marketing/blog pages, …) is left to the
                     browser — which is exactly the "stays in the browser"
                     intent of spec §4, achieved natively instead of bouncing
                     the link in and back out through a Custom Tab. -->
                <data android:scheme="https" android:host="saqqaar.com" android:path="/" />
                <data android:scheme="https" android:host="saqqaar.com" android:path="/new" />
                <data android:scheme="https" android:host="saqqaar.com" android:pathPrefix="/chats" />
                <data android:scheme="https" android:host="saqqaar.com" android:pathPrefix="/share" />
            </intent-filter>
            <!-- Disable the Flutter engine's own platform deep-linking so it
                 never forwards the tapped URL to go_router in parallel with the
                 app_links plugin (which would flash an error page for paths go_
                 router has no route for, e.g. /new or /privacy). app_links is a
                 plugin and receives the intent regardless of this flag. -->
            <meta-data
                android:name="flutter_deeplinking_enabled"
                android:value="false" />
            <!-- "Share to Saqqar" entry point. Surfaces the app in the
                 system share sheet (WhatsApp, Photos, Files, etc.).

                 IMPORTANT: use TOP-LEVEL wildcards, not enumerated subtypes.
                 WhatsApp (and many apps) share documents with a MIME type
                 that isn't a "nice" one — e.g. a PDF often comes through as
                 `application/octet-stream`, a CSV as `text/plain`, etc. An
                 earlier version listed specific subtypes (application/pdf,
                 …xlsx, text/csv) and so Saqqar simply DID NOT APPEAR in
                 WhatsApp's share sheet for those files. `application/*` +
                 `text/*` + `image/*` match every document/image the agent
                 can read. Non-file payloads (a shared plain-text message /
                 link) are filtered out on the Dart side in
                 ShareIntentBootstrap._toFiles, so a stray text share can't
                 open the picker with a broken "file". -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="image/*"/>
                <data android:mimeType="application/*"/>
                <data android:mimeType="text/*"/>
            </intent-filter>
            <!-- Multi-file share — Photos "Share 4 images" etc. The
                 receive_sharing_intent plugin demands a separate filter
                 because Android dispatches multi-payloads through
                 ACTION_SEND_MULTIPLE, not ACTION_SEND. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="image/*"/>
                <data android:mimeType="application/*"/>
                <data android:mimeType="text/*"/>
            </intent-filter>
        </activity>
        <!-- Force the Skia rendering backend (disable Impeller).
             Flutter 3.35 defaults to Impeller on Android, which SIGABRTs
             at launch / on resume on a class of GPUs + x86_64 emulators
             (the exact surface Google Play's automated review runs on —
             see Sentry SAQQAR-3: native Abort on an Android 11 x86_64
             reviewer emulator, first seen 1.0.0). Skia was the stable
             default for years and renders this app's gradients / splash
             animations identically. Revisit once Impeller's Android
             stability matures in a later Flutter SDK. -->
        <meta-data
            android:name="io.flutter.embedding.android.EnableImpeller"
            android:value="false" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- url_launcher (Gap G): lets the app resolve a browser for
             https record deep-links on Android 11+ (package visibility). -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
</manifest>
