<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Must EXACTLY match the App Group added to the Runner target.
	     receive_sharing_intent derives the group from the host bundle id:
	     group.<host bundle id> = group.sa.com.digitalharbor.saqqar -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.sa.com.digitalharbor.saqqar</string>
	</array>
</dict>
</plist>
