<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Saqqar</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>XPC!</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>AppGroupId</key>
	<string>group.sa.com.digitalharbor.saqqar</string>
	<key>NSExtension</key>
	<dict>
		<key>NSExtensionAttributes</key>
		<dict>
			<!-- What Saqqar accepts from the iOS share sheet. Mirrors the
			     Android ACTION_SEND mime list: images, PDFs, Office docs,
			     CSV/text. The MaxCount values enable multi-select share
			     (ACTION_SEND_MULTIPLE parity). -->
			<key>NSExtensionActivationRule</key>
			<dict>
				<key>NSExtensionActivationSupportsImageWithMaxCount</key>
				<integer>20</integer>
				<key>NSExtensionActivationSupportsFileWithMaxCount</key>
				<integer>20</integer>
				<key>NSExtensionActivationSupportsText</key>
				<true/>
				<key>NSExtensionActivationSupportsWebURLWithMaxCount</key>
				<integer>20</integer>
				<key>NSExtensionActivationSupportsWebPageWithMaxCount</key>
				<integer>20</integer>
			</dict>
		</dict>
		<!-- Xcode generates MainInterface.storyboard when you create the
		     Share Extension target; keep it. RSIShareViewController is the
		     storyboard's root controller (set its Custom Class to
		     ShareViewController in the Identity inspector). -->
		<key>NSExtensionMainStoryboard</key>
		<string>MainInterface</string>
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.share-services</string>
	</dict>
</dict>
</plist>
