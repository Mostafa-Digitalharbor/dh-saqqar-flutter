<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>CFBundleDevelopmentRegion</key>
		<string>$(DEVELOPMENT_LANGUAGE)</string>
		<key>CFBundleDisplayName</key>
		<string>Saqqar</string>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>CFBundleName</key>
		<string>Saqqar</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleSignature</key>
		<string>????</string>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<key>LSRequiresIPhoneOS</key>
		<true/>
		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>
		<key>UIMainStoryboardFile</key>
		<string>Main</string>
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>UISupportedInterfaceOrientations~ipad</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationPortraitUpsideDown</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
		<key>UIStatusBarHidden</key>
		<false/>
		<!-- Remote push wake-up. This is exactly what Xcode's
		     "Background Modes → Remote notifications" capability writes; adding
		     it here as a plain plist key pre-satisfies that step so the
		     backend's `content-available` pushes can wake the app in the
		     background. The Push Notifications *capability* (aps-environment,
		     in Runner.entitlements) still needs Xcode to wire the entitlements
		     file into the target — see docs/IOS_FIREBASE_HANDOFF.md. -->
		<key>UIBackgroundModes</key>
		<array>
			<string>remote-notification</string>
		</array>
		<!-- speech_to_text on iOS needs both keys: the mic capture is
		     gated by NSMicrophoneUsageDescription, and the on-device
		     recognition step is gated by NSSpeechRecognitionUsageDescription.
		     Strings are user-facing — keep them human and specific.
		     Defensive add for when iOS ships; currently only Android is
		     in distribution. -->
		<key>NSMicrophoneUsageDescription</key>
		<string>Saqqar uses the microphone for voice input in chat. Audio is processed on-device and never uploaded.</string>
		<key>NSSpeechRecognitionUsageDescription</key>
		<string>Saqqar transcribes your voice into chat text using the system speech recognizer. Recognition runs on-device.</string>
		<!-- file_picker / receive_sharing_intent expose Photos &amp; Files
		     on iOS — these keys are required even though the picker is
		     a system-presented UI (Apple still wants the rationale). -->
		<key>NSPhotoLibraryUsageDescription</key>
		<string>Saqqar lets you attach photos to chat messages so the AI assistant can read them.</string>
		<!-- Biometric app lock (local_auth). Required for Face ID; Touch ID
		     and the device passcode fallback need no extra key. -->
		<key>NSFaceIDUsageDescription</key>
		<string>Saqqar uses Face ID to unlock the app and protect your saved Odoo credentials.</string>
		<!-- permission_handler links the Camera &amp; Location APIs into the
		     binary even though the app does not actively use them, so Apple's
		     static check (ITMS-90683) requires these purpose strings to exist.
		     The app never prompts for these at runtime. -->
		<key>NSCameraUsageDescription</key>
		<string>Saqqar can use the camera to capture a photo to attach to a chat message so the AI assistant can read it.</string>
		<key>NSLocationWhenInUseUsageDescription</key>
		<string>Saqqar does not use your location. This entry is required by a system library and is never accessed.</string>
		<!-- Standard HTTPS encryption only — exempts the build from the
		     export-compliance prompt so it processes without "Missing Compliance". -->
		<key>ITSAppUsesNonExemptEncryption</key>
		<false/>
		<!-- URL schemes the app answers to.
		     * ShareMedia-<bundle id>: the redirect scheme receive_sharing_intent
		       uses to bring Saqqar forward AFTER the Share Extension has staged
		       the shared files into the App Group. REQUIRED for "Share → Saqqar"
		       to work on iOS — without it the extension can't hand off and the
		       app never appears / never receives the files.
		     * saqqar: the app's own deep-link scheme (saqqar://share/<token>),
		       handled by DeepLinks — registered here so iOS routes it to us. -->
		<key>CFBundleURLTypes</key>
		<array>
			<dict>
				<key>CFBundleTypeRole</key>
				<string>Editor</string>
				<key>CFBundleURLName</key>
				<string>sa.com.digitalharbor.saqqar.sharemedia</string>
				<key>CFBundleURLSchemes</key>
				<array>
					<string>ShareMedia-$(PRODUCT_BUNDLE_IDENTIFIER)</string>
				</array>
			</dict>
			<dict>
				<key>CFBundleTypeRole</key>
				<string>Editor</string>
				<key>CFBundleURLName</key>
				<string>sa.com.digitalharbor.saqqar.deeplink</string>
				<key>CFBundleURLSchemes</key>
				<array>
					<string>saqqar</string>
				</array>
			</dict>
		</array>
	</dict>
</plist>
