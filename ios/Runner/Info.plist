<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Saqqar</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<!-- The languages this app supports, declared to iOS.

	     Load-bearing, and it was missing. iOS filters `NSLocale.preferred-
	     Languages` down to the localizations a bundle actually declares, and
	     that filtered list is what Flutter surfaces as
	     `platformDispatcher.locale`. With only `Base.lproj` present the OS
	     reported English to an Arabic iPhone — so a Saudi user who had never
	     touched the in-app language switch (the "follow system" default, which
	     is every user on first launch) opened Saqqar in English, on a phone set
	     to Arabic, and had to find the toggle to fix it.

	     Android has no equivalent step: it hands the app the device locale
	     directly, which is why this only ever misbehaved on one platform.

	     Must stay in step with `AppStrings.supported` — `ios_localizations_
	     test` fails if the two lists diverge. It is also what App Store Connect
	     reads to list the app's languages on the product page. -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>ar</string>
	</array>
	<!-- Disable the Flutter engine's built-in deep-linking so it doesn't forward
	     Universal Links to go_router alongside the app_links plugin. app_links
	     receives the link via the plugin openURL/continueUserActivity callbacks
	     regardless of this flag, and is the single handler (routes via
	     DeepLinks). See docs/SAQQAR_DEEP_LINKS_FLUTTER.md §3. -->
	<key>FlutterDeepLinkingEnabled</key>
	<false/>
	<key>CFBundleName</key>
	<string>Saqqar</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>AppGroupId</key>
	<string>group.sa.com.digitalharbor.saqqar</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>sa.com.digitalharbor.saqqar.sharemedia</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>ShareMedia-$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>sa.com.digitalharbor.saqqar.deeplink</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>saqqar</string>
			</array>
		</dict>
		<!-- Google Sign-In callback: the REVERSED iOS OAuth client ID.
		     Must match GIDClientID below and the iOS client ID in the
		     Google Cloud project (487560580263). -->
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>google-signin</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.487560580263-mteed8gpe4eb525bjtamc5e4328tgqfe</string>
			</array>
		</dict>
	</array>
	<!-- Google Sign-In iOS client ID (google_sign_in reads this at init). -->
	<key>GIDClientID</key>
	<string>487560580263-mteed8gpe4eb525bjtamc5e4328tgqfe.apps.googleusercontent.com</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>Saqqar can use the camera to capture a photo to attach to a chat message so the AI assistant can read it.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Saqqar uses Face ID to unlock the app and protect your saved Odoo credentials.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Saqqar uses the microphone for voice input in chat. Your recording is sent to Saqqar's servers to be transcribed into text, and is not kept afterwards.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Saqqar lets you attach photos to chat messages so the AI assistant can read them.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIStatusBarHidden</key>
	<false/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
