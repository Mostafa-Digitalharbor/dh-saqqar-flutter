<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>CFBundleDevelopmentRegion</key>
		<string>$(DEVELOPMENT_LANGUAGE)</string>
		<key>CFBundleDisplayName</key>
		<string>Saqqar</string>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>CFBundleName</key>
		<string>Saqqar</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleSignature</key>
		<string>????</string>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<key>LSRequiresIPhoneOS</key>
		<true/>
		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>
		<key>UIMainStoryboardFile</key>
		<string>Main</string>
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>UISupportedInterfaceOrientations~ipad</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationPortraitUpsideDown</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
		<key>UIStatusBarHidden</key>
		<false/>
		<!-- speech_to_text on iOS needs both keys: the mic capture is
		     gated by NSMicrophoneUsageDescription, and the on-device
		     recognition step is gated by NSSpeechRecognitionUsageDescription.
		     Strings are user-facing — keep them human and specific.
		     Defensive add for when iOS ships; currently only Android is
		     in distribution. -->
		<key>NSMicrophoneUsageDescription</key>
		<string>Saqqar uses the microphone for voice input in chat. Audio is processed on-device and never uploaded.</string>
		<key>NSSpeechRecognitionUsageDescription</key>
		<string>Saqqar transcribes your voice into chat text using the system speech recognizer. Recognition runs on-device.</string>
		<!-- file_picker / receive_sharing_intent expose Photos &amp; Files
		     on iOS — these keys are required even though the picker is
		     a system-presented UI (Apple still wants the rationale). -->
		<key>NSPhotoLibraryUsageDescription</key>
		<string>Saqqar lets you attach photos to chat messages so the AI assistant can read them.</string>
		<!-- permission_handler links the Camera &amp; Location APIs into the
		     binary even though the app does not actively use them, so Apple's
		     static check (ITMS-90683) requires these purpose strings to exist.
		     The app never prompts for these at runtime. -->
		<key>NSCameraUsageDescription</key>
		<string>Saqqar can use the camera to capture a photo to attach to a chat message so the AI assistant can read it.</string>
		<key>NSLocationWhenInUseUsageDescription</key>
		<string>Saqqar does not use your location. This entry is required by a system library and is never accessed.</string>
		<!-- Standard HTTPS encryption only — exempts the build from the
		     export-compliance prompt so it processes without "Missing Compliance". -->
		<key>ITSAppUsesNonExemptEncryption</key>
		<false/>
	</dict>
</plist>
