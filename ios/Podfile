platform :ios, '15.0'

require 'xcodeproj'

# CocoaPods 1.16.2 / xcodeproj 1.27 can encounter Xcode projects with
# objectVersion 70 but does not map that version to a compatibility string.
# Keep this local shim until the installed xcodeproj gem supports it.
unless Xcodeproj::Constants::COMPATIBILITY_VERSION_BY_OBJECT_VERSION.key?(70)
  compatibility_versions =
    Xcodeproj::Constants::COMPATIBILITY_VERSION_BY_OBJECT_VERSION.dup
  compatibility_versions[70] = 'Xcode 16.0'
  Xcodeproj::Constants.send(
    :remove_const,
    :COMPATIBILITY_VERSION_BY_OBJECT_VERSION,
  )
  Xcodeproj::Constants.const_set(
    :COMPATIBILITY_VERSION_BY_OBJECT_VERSION,
    compatibility_versions.freeze,
  )
end

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

target 'Share Extension' do
  use_frameworks!
  inherit! :search_paths
  pod 'receive_sharing_intent', :path => '.symlinks/plugins/receive_sharing_intent/ios'
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['DEBUG_INFORMATION_FORMAT'] = 'dwarf-with-dsym'

      # Every embedded framework carries its own MinimumOSVersion, and App
      # Store Connect validates the lowest one it finds — not just the app
      # binary's. `flutter_additional_ios_build_settings` only raises a pod
      # to *Flutter's* floor (13.0), so without this a pod that predates the
      # bump keeps shipping 13.0 inside a 15.0 app and re-triggers
      # ITMS-90068.
      #
      # Raise-only: a pod that already demands something newer than 15.0
      # must keep it, or it fails to compile against APIs it declared.
      current = config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'].to_s
      if current.to_f < 15.0
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      end

      # permission_handler_apple compiles each permission behind a
      # PERMISSION_* macro that defaults to **0** (see its
      # PermissionHandlerEnums.h). With every macro off,
      # AudioVideoPermissionStrategy.m compiles down to a bare
      # `@implementation ... @end` — an empty class — while
      # PermissionManager.m still hands that class back for
      # PermissionGroupMicrophone. `Permission.microphone.status` /
      # `.request()` (chat voice input) then send a selector the shipped
      # class does not implement, which is an unrecognized-selector crash
      # on the first tap of the mic button.
      #
      # Turn microphone ON — it is the only permission the app requests
      # through this plugin. The rest stay 0 so the binary keeps no
      # reference to location / speech / contacts / tracking APIs we never
      # use, which is what would otherwise force matching (and reviewable)
      # purpose strings into Info.plist.
      #
      # NOTE: camera + photo-library stay 0 here on purpose. image_picker
      # drives those through its own APIs, not permission_handler, so their
      # Info.plist strings are still required and must NOT be removed.
      defs = config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] || ['$(inherited)']
      defs = defs.split(' ') if defs.is_a?(String)
      defs |= [
        'PERMISSION_MICROPHONE=1',
        'PERMISSION_CAMERA=0',
        'PERMISSION_PHOTOS=0',
        'PERMISSION_PHOTOS_ADD_ONLY=0',
        'PERMISSION_LOCATION=0',
        'PERMISSION_SPEECH_RECOGNIZER=0',
        'PERMISSION_NOTIFICATIONS=0',
        'PERMISSION_CONTACTS=0',
        'PERMISSION_EVENTS=0',
        'PERMISSION_EVENTS_FULL_ACCESS=0',
        'PERMISSION_REMINDERS=0',
        'PERMISSION_MEDIA_LIBRARY=0',
        'PERMISSION_SENSORS=0',
        'PERMISSION_BLUETOOTH=0',
        'PERMISSION_APP_TRACKING_TRANSPARENCY=0',
        'PERMISSION_CRITICAL_ALERTS=0',
        'PERMISSION_ASSISTANT=0',
      ]
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = defs
      # receive_sharing_intent's SwiftReceiveSharingIntentPlugin calls
      # addApplicationDelegate, which the compiler forbids in extension targets.
      # Disabling the extension-only API check for this pod lets it compile for
      # the Share Extension without changing the plugin source.
      if target.name.include?('receive_sharing_intent')
        config.build_settings['APPLICATION_EXTENSION_API_ONLY'] = 'NO'
      end
    end
  end
end
